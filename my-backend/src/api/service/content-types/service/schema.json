{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service "
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "icon": {
      "type": "string"
    },
    "photo_url": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "features": {
      "type": "string"
    },
    "price_range": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "order_index": {
      "type": "integer",
      "default": 0
    }
  }
}
