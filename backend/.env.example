# Copy this file to backend/.env and fill in real values. Never commit .env.

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname

# ── Contact form + AI-agent lead emails (Gmail App Password) ─
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=you@example.com
EMAIL_TO=you@example.com

# ── CORS (comma separated, e.g. your Vercel URL) ─────────────
CORS_ORIGINS=

# ── AI agent (POST /api/v1/agent/chat) ───────────────────────
# Required. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
# Optional
OPENAI_MODEL=gpt-4o-mini
# Max chat requests per IP per minute
AGENT_RATE_LIMIT_PER_MIN=20
